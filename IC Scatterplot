# Load necessary library
library(tidyverse)
 
 data <- SARSCoV2_Ct_Dates
 
 # Create a series identifier based on 0 in the Days column
 data$series <- cumsum(data$Days == 0)
 
 # Define a color palette
 colors <- rainbow(length(unique(data$series)))
 
 # Define point characters based on series
pch_values <- ifelse(data$series == 7, 16,  # Circle for series 7
                     ifelse(data$series == 3, 15,  # Square for series 3
                            17))  # Triangle for others
 
 # Base R scatterplot with lines connecting points and different colors
 plot(x = data$Days, y = data$Ct,
      main = "Scatterplot of Ct vs. Days",
      xlab = "Days", 
      ylab = "Ct",
      col = colors[data$series],  
      pch = pch_values, 
      type = 'p')
 
 # Draw lines for each series
 for (i in unique(data$series)) {
     subset_data <- data[data$series == i, ]
     lines(subset_data$Days, subset_data$Ct, col = colors[i]) }

 # Add a legend
legend("topright", legend = c("Asymptomatic (Circle)", "Outpatient (Square)", "Inpatient, no ICU (Triangle)", "Inpatient, ICU (Star)", "Inpatient, Death (Plus)"), pch = c(1, 15, 17, 8, 3), col = rep("black", 5), bty = "n")
